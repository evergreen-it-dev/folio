# Development from source: copy to `.env`, start the dependencies
# (`docker compose up -d`), then `npm run dev`.

PORT=4870
PUBLIC_URL=http://localhost:4871

# Public sites (a space set to "public" is readable by anyone without signing
# in): <PUBLIC_URL>/public/<space> always works. PUBLIC_SITES_DOMAIN additionally
# lets a space admin pick <label>.<this domain>; it needs wildcard DNS and a
# wildcard certificate on the reverse proxy, routed to this app. A custom domain
# set per space needs a CNAME to the instance host and the proxy routing that
# host to this app too.
# PUBLIC_SITES_DOMAIN=sites.example.com
# PDF/DOCX exports one IP may start per minute on public sites (default 6).
# PUBLIC_EXPORT_PER_MINUTE=6
# "Ask Folio AI" on public sites (opt-in per space; uses the space or instance
# shared key, else CURSOR_API_KEY): questions one IP may ask per hour across all
# public sites (default 20), and all visitors of one site together (default 200).
# PUBLIC_ASSISTANT_RUNS_PER_HOUR=20
# PUBLIC_ASSISTANT_SPACE_RUNS_PER_HOUR=200

DATABASE_URL=postgres://folio:folio@localhost:5490/folio
REDIS_URL=redis://localhost:6390

# Encrypts saved git tokens and personal AI keys at rest (AES-256-GCM, see
# server/secretCrypto.ts). The value below is fine for local development; a
# REAL DEPLOYMENT MUST SET ITS OWN unique secret (`openssl rand -hex 32`) —
# anyone who knows it can decrypt every saved credential in the database.
# Without it, saving a credential is refused with a clear error instead of
# storing plaintext. Do not change it later: already saved credentials would
# stop decrypting.
FOLIO_SECRET=dev-only-folio-secret-change-in-production

# Prefilled into the create-space dialog's repository field. May point at a
# brand-new empty repository. Optional; users can type any other URL.
# FOLIO_DEFAULT_REPO_URL=https://gitlab.example.com/your-org/folio-data

# Where uploaded files live: local | s3
ASSET_BACKEND=local
# S3_ENDPOINT=http://localhost:9100
# S3_BUCKET=folio-assets
# S3_ACCESS_KEY=folio
# S3_SECRET_KEY=folio-minio-dev
# S3_REGION=us-east-1

# "Sign in with Google" (the `google` SSO provider, server/auth/providers.ts). The button appears only when
# both the client id and secret are set. GOOGLE_ALLOWED_DOMAINS is a
# comma-separated allowlist of email domains; when it is empty, Google
# sign-in lets nobody in.
# Redirect URI to register: <PUBLIC_URL>/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_ALLOWED_DOMAINS=example.com

# Single sign-on through any OpenID Connect provider (docs/AUTH.md): one block
# per provider, FOLIO_OIDC_<SLUG>_*. Redirect URL: <PUBLIC_URL>/api/auth/oidc/<slug>/callback.
# Local Keycloak: docker compose --profile sso up -d keycloak (see docker-compose.yml).
# FOLIO_OIDC_KEYCLOAK_ISSUER=http://localhost:8085/realms/folio
# FOLIO_OIDC_KEYCLOAK_CLIENT_ID=folio
# FOLIO_OIDC_KEYCLOAK_CLIENT_SECRET=folio-dev-secret
# FOLIO_OIDC_KEYCLOAK_NAME=Keycloak
# FOLIO_OIDC_KEYCLOAK_DOMAINS=acme.test
# FOLIO_OIDC_KEYCLOAK_JIT=true
# FOLIO_OIDC_KEYCLOAK_JIT_SPACES=handbook:viewer
# FOLIO_OIDC_KEYCLOAK_ENFORCE=false
# Group sync at sign-in (docs/AUTH.md §11), the same _GROUP_* names for FOLIO_SAML_<SLUG>_:
# FOLIO_OIDC_KEYCLOAK_GROUP_SYNC=true
# FOLIO_OIDC_KEYCLOAK_GROUP_MAP=Engineering=eng,Support=support   # omit to match by group name or slug
# FOLIO_OIDC_KEYCLOAK_GROUP_CREATE=false
# FOLIO_OIDC_KEYCLOAK_GROUP_ALLOW=folio-,team-                     # prefixes or /regex/

# SAML 2.0 (docs/AUTH.md §10): FOLIO_SAML_<SLUG>_*. Register at the IdP: entity ID
# <PUBLIC_URL>/api/auth/saml/<slug>/metadata (or _SP_ENTITY_ID), ACS <PUBLIC_URL>/api/auth/saml/<slug>/acs.
# The local Keycloak realm has a SAML client folio-saml:
# FOLIO_SAML_KEYCLOAK_SAML_METADATA_URL=http://localhost:8085/realms/folio/protocol/saml/descriptor
# FOLIO_SAML_KEYCLOAK_SAML_SP_ENTITY_ID=folio-saml
# FOLIO_SAML_KEYCLOAK_SAML_NAME=Keycloak (SAML)
# FOLIO_SAML_KEYCLOAK_SAML_DOMAINS=acme.test
# FOLIO_SAML_KEYCLOAK_SAML_JIT=true
# SCIM 2.0 provisioning (/scim/v2): the token is generated per provider at /admin/auth.
# Requests allowed per token per minute (default 1200).
# FOLIO_SCIM_RATE_PER_MINUTE=1200

# "Connect with GitHub" (server/auth/githubConnect.ts): a signed-in user links
# a github.com account in "Git access" instead of pasting a token. Register a
# GitHub OAuth App (not a GitHub App) with the callback URL
# <PUBLIC_URL>/api/auth/github-connect/callback. The button appears only when
# both values (and FOLIO_SECRET) are set; GitHub Enterprise still uses tokens.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Link previews in Slack (server/integrations/chat): create the Slack app from the
# manifest an instance admin downloads in Folio (Administration > Chat integrations),
# install it to the workspace, then copy these from the app's settings. Each person
# connects their own Folio account the first time they share a Folio link. Needs
# PUBLIC_URL (https) and FOLIO_SECRET. FOLIO_SLACK_TEAM_ID (T...) is optional: it
# limits connections to that one workspace.
# FOLIO_SLACK_SIGNING_SECRET=
# FOLIO_SLACK_BOT_TOKEN=xoxb-...
# FOLIO_SLACK_CLIENT_ID=
# FOLIO_SLACK_CLIENT_SECRET=
# FOLIO_SLACK_TEAM_ID=

# Link previews in Microsoft Teams: an Azure Bot (single tenant) whose messaging
# endpoint is <PUBLIC_URL>/api/integrations/teams/messages, and the Teams app
# package from Administration > Chat integrations uploaded to the org catalog.
# The app password is not used by previews (they answer Teams inline); keep it for
# later features.
# FOLIO_TEAMS_APP_ID=
# FOLIO_TEAMS_TENANT_ID=
# FOLIO_TEAMS_APP_PASSWORD=

# Optional analytics (server/analytics.ts). OFF by default: Folio sends no telemetry.
# Set a PostHog project token of YOUR OWN to see how a public demo is used; only
# anonymous events (page kinds, space slugs, steps of an AI-app connection) are
# sent, never page content. Empty = nothing is loaded and nothing is contacted.
# FOLIO_POSTHOG_KEY=
# FOLIO_POSTHOG_HOST=https://eu.i.posthog.com

# Optional error reporting and the "Report a problem" dialog (server/sentry.ts,
# web/src/sentry). OFF by default: without SENTRY_DSN nothing is loaded and nobody
# is contacted. The DSN of the Sentry project (a public key) switches it on for the
# server AND the browser (the web app gets it from /api/auth/state).
# SENTRY_DSN=
# development when NODE_ENV is not production, production otherwise:
# SENTRY_ENVIRONMENT=development-local
# Share of requests traced for performance, 0..1 (default 0.1; 0 = no traces):
# SENTRY_TRACES_SAMPLE_RATE=0.1
# 1 adds CPU profiles to traced requests (needs the optional @sentry/profiling-node):
# SENTRY_PROFILES=0
# Release name; the image build sets FOLIO_RELEASE (the short git sha) and it is used by default:
# SENTRY_RELEASE=
# Session Replay (masked: all text, inputs and images hidden; canvases and iframes
# not recorded). On when SENTRY_DSN is set; 0 turns it off. ON_ERROR is the share
# of visits with an error whose last minute is sent (default 1); SESSION_RATE is the
# share of whole visits recorded from the start (default 0). A report attaches the
# recording only when the person leaves the box ticked.
# SENTRY_REPLAY=1
# SENTRY_REPLAY_ON_ERROR=1
# SENTRY_REPLAY_SESSION_RATE=0

# Public-demo mode (server/demo.ts). OFF by default — an ordinary instance
# never serves any of this. When on, the login screen shows a "Public demo —
# sign in as…" block with the accounts below, a thin banner shows in the app,
# and a demo account is barred from creating API tokens and changing passwords.
# The demo passwords are PUBLIC by design: they are handed out only while the
# mode is on, and never logged. The accounts themselves must already exist
# (seed them); this only advertises them.
# FOLIO_DEMO_MODE=1
# A JSON array, or a path to a file holding one:
# FOLIO_DEMO_ACCOUNTS=[{"email":"editor@demo.example","password":"demo-password","name":"Dana Editor","role":"Editor","description":"Editor in Engineering and Product"}]
# How often the operator resets the demo data; shown to visitors (optional).
# FOLIO_DEMO_RESET_HOURS=6
# Link preview (LinkedIn, Slack, ...): title, description and a 1200x630 image of
# the instance's front page. Defaults are neutral (and the demo has its own);
# set any of these to override. FOLIO_OG_IMAGE is a path under this site or an
# absolute URL.
# FOLIO_OG_TITLE=Acme wiki
# FOLIO_OG_DESCRIPTION=Our team's knowledge base
# FOLIO_OG_IMAGE=/og/og-folio.png
# In demo mode ONLY, these are switched off for everybody (403 "disabled in the
# public demo"): API tokens, the AI assistant and AI keys, git/Confluence
# endpoints that connect to a caller-chosen host (/api/git/*, creating a space,
# connect-git, /api/import/*, saved git/Confluence credentials), share links,
# invites, and changing name/username. A demo account also cannot change a
# password. Uploads are capped:
# FOLIO_DEMO_MAX_UPLOAD_MB=5
# /mcp and OAuth limits, demo mode ONLY (server/demoLimits.ts; in process memory,
# per request.ip, so set TRUST_PROXY behind a proxy). 429 + Retry-After + a JSON-RPC error.
# Requests per minute per user+IP on /mcp (a failed login counts per IP):
# FOLIO_DEMO_MCP_RPM=60
# Writing tool calls (readOnlyHint=false) per hour per IP:
# FOLIO_DEMO_MCP_WRITES_PER_HOUR=100
# Fixed, not configurable: /mcp body 1 MiB, one write's arguments 200 KiB,
# POST /oauth/authorize and POST /oauth/token 30/min per IP.

# Behind a reverse proxy (nginx, Traefik, Caddy), request.ip is the proxy's
# address for every visitor, and the login rate limit (10/min per IP) becomes
# one shared bucket for everybody. TRUST_PROXY=true makes the app believe the
# client address the proxy reports in X-Forwarded-For — but only from a proxy on
# a loopback/private address (same host, or the docker network), and only the
# entry the proxy appended, never one a client forged. Also accepted: a
# comma-separated list of proxy addresses/CIDRs. A bare hop count ("1") is
# refused. Unset = no proxy: the TCP peer is the client (the safe default when
# the port is reachable directly).
# TRUST_PROXY=true

# AI assistant (Cursor SDK). Each user normally connects a personal Cursor API
# key in their account settings (stored encrypted with FOLIO_SECRET).
# CURSOR_API_KEY is an optional operator-level fallback for everyone. Admins can
# also set shared keys in the UI (one for the whole instance, one per space;
# stored encrypted with FOLIO_SECRET) - those take precedence over this variable.
# The runtime needs Node.js >= 22.13; on older Node the assistant reports itself
# unavailable and the rest of Folio keeps working.
# CURSOR_API_KEY=

# Other providers of the assistant. Normally connected in the UI (personal, space
# or instance level, stored encrypted with FOLIO_SECRET); these variables are the
# operator-level fallback, used last. MINIMAX_BASE_URL overrides the API endpoint.
# Claude runs only on an API key billed to Anthropic API usage, never a subscription.
# ANTHROPIC_API_KEY=
# MINIMAX_API_KEY=
# MINIMAX_BASE_URL=https://api.minimax.io/v1

# Optional providers, off by default. With a flag unset the provider is not listed,
# not used (even with a saved credential or an environment key) and its routes answer 404.
# FOLIO_MINIMAX_ENABLED=1 turns on MiniMax (an API key; MINIMAX_API_KEY and MINIMAX_BASE_URL above).
# FOLIO_CODEX_ENABLED=1 turns on Codex through a ChatGPT sign-in, for a server you run
# for yourself. OpenAI has not confirmed this use on shared servers, and device-code
# sign-in must be enabled in your ChatGPT security settings. Each person signs in
# with their own account; the sign-in is never shared.
# FOLIO_MINIMAX_ENABLED=
# FOLIO_CODEX_ENABLED=

# Default model for new assistant conversations ('auto' lets Cursor choose).
CURSOR_AGENT_MODEL=auto

# Per-conversation workspace and the SDK's own state. Default: subfolders of
# the data directory.
# CURSOR_AGENT_WORKSPACE_ROOT=
# CURSOR_AGENT_STATE_DIR=

# Deadlines for one assistant run, in milliseconds: Ask mode, Agent mode, and
# the idle limit (no activity at all from the SDK).
CURSOR_AGENT_TIMEOUT_MS=300000
CURSOR_AGENT_TIMEOUT_MS_AGENT=1800000
CURSOR_AGENT_IDLE_TIMEOUT_MS=600000

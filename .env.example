# Settings for `docker compose up -d`. Everything here is optional:
# copy this file to `.env` only when you need to change something.
#
# Developing Folio from source uses a different file: .env.dev.example.

# The address people type to open Folio. Links in invitations and shared
# pages are built from it. Set it before inviting anyone.
#   on your own computer:   http://localhost:4870
#   on a server with HTTPS: https://wiki.example.com
PUBLIC_URL=http://localhost:4870

# Port on this machine.
FOLIO_PORT=4870

# 0.0.0.0 = reachable from other machines; 127.0.0.1 = this machine only
# (use that when a reverse proxy in front of Folio handles HTTPS).
FOLIO_BIND=0.0.0.0

# Domain for the bundled HTTPS proxy (`docker compose --profile https up -d`).
# FOLIO_DOMAIN=wiki.example.com

# Encrypts saved git tokens and personal AI keys. Leave empty and Folio
# generates one on first start and keeps it on the data volume. If you set
# your own (`openssl rand -hex 32`), never change it afterwards: credentials
# saved earlier would stop decrypting.
# FOLIO_SECRET=

# Database password. It is applied when the database is created for the
# first time; changing it later here does not change it in the database.
# POSTGRES_PASSWORD=folio

# "Sign in with Google". The button appears when both the id and the secret
# are set. GOOGLE_ALLOWED_DOMAINS is a comma-separated list of email domains
# that may sign in; when it is empty, Google sign-in lets nobody in.
# Redirect URI to register with Google: <PUBLIC_URL>/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_ALLOWED_DOMAINS=example.com

# AI assistant. Each person normally adds a personal Cursor API key in their
# account settings; this one is an optional shared fallback for everyone.
# CURSOR_API_KEY=
# CURSOR_AGENT_MODEL=auto

# Link preview (LinkedIn, Slack, Telegram, ...) of the front page: title,
# description and a 1200x630 picture. The defaults are neutral; set any of
# these to override. FOLIO_OG_IMAGE is a path under this site or an absolute
# address.
# FOLIO_OG_TITLE=Acme wiki
# FOLIO_OG_DESCRIPTION=Our team's knowledge base
# FOLIO_OG_IMAGE=/og/og-folio.png

# Optional analytics for a demo you run. OFF by default: Folio sends no
# telemetry. A PostHog project token of your own turns on anonymous events
# (page kinds, space slugs, never content). Empty means nothing is loaded and
# nobody is contacted. See docs/INSTALL.md.
# FOLIO_POSTHOG_KEY=
# FOLIO_POSTHOG_HOST=https://eu.i.posthog.com

# Behind your own reverse proxy (nginx, Traefik, ...) on the same host or
# Docker network: set to true so the sign-in rate limit is counted per visitor
# instead of one shared bucket for everybody. Only a proxy on a loopback or
# private address is believed. Leave unset when the port is reachable directly.
# TRUST_PROXY=true

# Prefilled into the "create space" dialog's repository field (users can type
# any other address).
# FOLIO_DEFAULT_REPO_URL=https://git.example.com/your-org/folio-data

# AI assistant run deadlines, in milliseconds: Ask mode, Agent mode, and the
# idle limit (no activity at all). Empty keeps the defaults shown here.
# CURSOR_AGENT_TIMEOUT_MS=300000
# CURSOR_AGENT_TIMEOUT_MS_AGENT=1800000
# CURSOR_AGENT_IDLE_TIMEOUT_MS=600000

# Public-demo mode, for running your own demo. OFF by default. When on, the
# sign-in screen offers the demo accounts below, a banner shows in the app, and
# API tokens, the assistant, outbound git and import, new spaces, share links
# and invitations are disabled. The accounts must already exist (create them
# first); this only advertises them, and their passwords become public.
# FOLIO_DEMO_MODE=1
# A JSON array; wrap it in single quotes so Docker Compose keeps it as is:
# FOLIO_DEMO_ACCOUNTS='[{"email":"editor@demo.example","password":"demo-password","name":"Dana Editor","role":"Editor","description":"Editor in Engineering and Product"}]'
# How often you reset the demo data; shown to visitors (optional).
# FOLIO_DEMO_RESET_HOURS=6
# Upload cap in demo mode, MB (default 5), and /mcp limits in demo mode:
# requests per minute per user and address (default 60), writing tool calls
# per hour per address (default 100).
# FOLIO_DEMO_MAX_UPLOAD_MB=5
# FOLIO_DEMO_MCP_RPM=60
# FOLIO_DEMO_MCP_WRITES_PER_HOUR=100
